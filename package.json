{
  "name": "llm-api-proxy",
  "version": "1.0.0",
  "description": "统一 LLM API 代理网关，支持多 Provider 自动路由与故障切换",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  },
  "dependencies": {
    "express": "^4.21.2",
    "yaml": "^2.7.0",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.24.2",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
